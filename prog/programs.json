{
    "os" : {
        "Darwin" : {
            "program" : "brew",
            "args" : [ "install" ]
        },
        "Fedora" : {
            "program" : "sudo",
            "args" : [ "dnf", "install", "-y" ]
        },
        "Debian" : {
            "program" : "sudo",
            "args" : [ "apt", "install", "-y"]
        }
    },
    "programs" : [
        { "default" : "git" },
        { "default" : "neovim" },
        { "default" : "tmux" },
        { "default" : "fzf" },
        { "default" : "zsh" },
        { "default" : "htop" },
        { "default" : "btop" },
        {
            "Fedora" : "golang",
            "default" : "go"
        },
        {
            "Fedora" : "@development-tools",
            "Debian" : "build-essential"
        },
        {
            "default" : "gdb"
        },
        {
            "Fedora" : "clangd"
        },
        {
            "Fedora" : "lua",
            "Debian" : "lua",
            "Darwin" : "lua"
        },
        {
            "Fedora" : "lua-lpeg",
            "Debian" : "lua-lpeg-dev",
            "Darwin" : "lpeg"
        },
        {
            "Fedora" : "tre",
            "Debian" : "libtre-dev",
            "Darwin" : "tre"
        }
    ],
    "vcs" : {
        "git" : {
            "program" : "git",
            "args": [ "clone" ]
        },
        "wget" : {
            "program" : "wget",
            "args" : []
        }
    },
    "sources" : [
        {
            "type" : "git",
            "target" : "$HOME/personal",
            "repo" : "https://github.com/9fans/plan9port.git",
            "dir" : "plan9port",
            "command" : [
                { "program" : "./INSTALL", "args": [] }
            ]
        },
        {
            "type" : "git",
            "target" : "$HOME/Downloads",
            "repo" : "https://github.com/martanne/vis.git",
            "dir" : "vis",
            "command" : [
                { "program" : "./configure", "args" : [ "--prefix=/opt/vis", "--disable-lpeg-static" ] },
                { "program" : "make", "args" : [] },
                { "program" : "sudo", "args" : [ "make", "install" ] }
            ]
        }
    ]
}
